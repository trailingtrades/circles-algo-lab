# Local development. On the VPS the same keys arrive in /etc/learn-smart.env, written from GitHub secrets by
# .github/workflows/deploy-smart-vps.yml (age-encrypted). Optional keys there are written only when set.

# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Every auth redirect (sign-in, invite, reset, callback) is built from this, never from the request URL.
# Running `next dev` on another port? Set it to match, e.g. http://localhost:3005, or redirects land on :3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production builds only: NEXT_PUBLIC_BASE_PATH=/smart and NEXT_OUTPUT_STANDALONE=1 (set by the deploy workflow).

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
# Never change once a certificate exists: it signs every verify link.
CERT_SIGNING_SECRET=
# The one account allowed to change roles (setRole + the People page). Set it in production.
MASTER_ADMIN_EMAIL=

# Transactional email — Resend. Sender must be on a domain verified in Resend. Without a key, invites and
# certificate emails are skipped (logged, not sent).
RESEND_API_KEY=
EMAIL_FROM="Circle S.M.A.R.T <learn@5circles.co>"

# Certificate PDF rendering. "local" = python3 + WeasyPrint on this host. "dispatch" = hand off to the GitHub Actions
# job .github/workflows/cert-render.yml (use this on the VPS). The token is a fine-grained PAT for this repo only,
# Contents: Read & write; in GitHub it is saved as the secret CERT_DISPATCH_TOKEN (names may not start with GITHUB_).
CERT_RENDER_MODE=dispatch
GITHUB_REPO=trailingtrades/circles-algo-lab
GITHUB_DISPATCH_TOKEN=

# Local RLS tests only
DATABASE_URL=postgresql://postgres@localhost:5499/learn_test
